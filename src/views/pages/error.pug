extends ../layouts/default

block content
  div(class='hero min-h-screen')
    div(class='hero-content text-center')
      div
        case sysError.status
          when 404
            //- script(src='https://unpkg.com/@dotlottie/player-component@2.7.12/dist/dotlottie-player.mjs', type='module')
            //- dotlottie-player(src='https://lottie.host/0bc8129e-b683-4eac-83e1-8d76921542ae/rPMagDjhv1.lottie', background='transparent', speed='1', style='width: 460px; height: 200px', loop, autoplay)
            h1(class='text-5xl font-bold') 404
            h1(class='text-5xl font-bold') Page not found
            p(class='py-6') The page you are looking for does not exist.
            a(class='btn btn-primary' href='/') Go back to home
          when 500
            //- script(src='https://unpkg.com/@dotlottie/player-component@2.7.12/dist/dotlottie-player.mjs', type='module')
            //- dotlottie-player(src='https://lottie.host/a14598c2-4454-4023-a5d1-2787e005a021/NjD7viyPqX.lottie', background='transparent', speed='1', style='width: 460px; height: 200px', loop, autoplay)
            h1(class='text-5xl font-bold') 500
            h1(class='text-5xl font-bold') Internal server error
            p(class='py-6') Something went wrong on our end.
            a(class='btn btn-primary' href='/') Go back to home
          when 403
            h1(class='text-5xl font-bold') 403
            h1(class='text-5xl font-bold') Forbidden
            p(class='py-6') You do not have permission to access this page.
            a(class='btn btn-primary' href='/') Go back to home
          default
            h1(class='text-5xl font-bold') Something went wrong
            p(class='py-6') An unexpected error occurred.
            a(class='btn btn-primary' href='/') Go back to home
        
        
        if developmentEnv
          div.mt-10.mockup-code.w-full.text-left
            div(class='overflow-x-auto w-full')
              pre(class='language-javascript')
                code
                  | #{sysError.message}
                  | #{sysError.status}
                  | #{sysError.stack}






            //- h2(class='text-2xl font-bold') Error Details
            //- p(class='py-6')= error.message
            //- if error.stack
            //-   pre(class='whitespace-pre-wrap')= error.stack
            //- else
            //-   p(class='py-6') No stack trace available.

      //- h1= message
      //- h2= error.status
      //- pre #{error.stack}
