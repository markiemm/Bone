extends ../../layouts/settings

block content
    div.flex.flex-row.items-center.justify-between.mb-6.gap-4
        div(class="w-1/3 mx-auto")
            div.flex.flex-col.items-center.gap-4
                div(class='avatar flex justify-center')
                    div(class='ring-primary ring-offset-base-100 w-64 rounded-full ring-2 ring-offset-2')
                        img(src='https://img.daisyui.com/images/profile/demo/yellingcat@192.webp')
                span(class='font-bold text-2xl')= user.username

                div(class='flex flex-col items-center gap-2')
                    span(class='text-sm text-center')
                        | Joined on 
                        strong=moment(user.createdAt).format('MMMM Do, YYYY')

        div.w-full.mt-6
            h2(class='text-2xl font-bold mb-4') Edit Profile

            form(action='/settings/profile' method='POST' class='flex flex-col gap-4')
                div.flex.flex-col.gap-2
                    label(for='username' class='font-semibold') Username
                    input#username(type='text' name='username' placeholder='Username' value='johndoe' class='input input-bordered w-full')

                div.flex.flex-col.gap-2
                    label(for='email' class='font-semibold') Email
                    input#email(type='email' name='email' placeholder='Email' value=user.email class='input input-bordered w-full')

                button(type='submit' class='btn btn-primary mt-4 w-32') Save Changes