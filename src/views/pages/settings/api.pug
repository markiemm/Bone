extends ../../layouts/settings

block content
	h2(class='text-2xl font-bold mb-4') API Settings


	div.flex.flex-col.gap-3
		h3(class='text-xl font-semibold') Your API Key
		if newApiKey
			p(class='text-base-content') Here is your API key. Please store it securely as it will not be shown again.
			pre(class='bg-base-200 p-4 rounded-lg overflow-x-auto')
				code= newApiKey

		else
		
			if userKey
				div(role='alert', class='alert alert-warning alert-dash')
						span Regenerating your API key will invalidate any other existing keys.
				form(action='/settings/api?method=regenerateApiKey' method='POST' class='mt-4')
					button(type='submit' class='btn') Regenerate API Key
				

			else
				p(class='text-base-content') You do not have an API key yet.
				form(action='/settings/api?method=generateApiKey' method='POST' class='mt-4')
					button(type='submit' class='btn btn-primary') Generate API Key
	div.divider