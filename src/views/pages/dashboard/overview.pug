extends ../../layouts/main

block content
    div.flex.flex-col(class='md:flex-row md:items-center md:justify-between mb-6 gap-4')

        div(class='card w-full md:w-1/4 overflow-hidden')
            div(class='card-body gap-4')
                h2(class='flex items-center justify-between')
                    span(class='flex items-center gap-2 font-semibold')
                        i.fas.fa-chart-bar.fa-lg.opacity-40
                        | Stats overview
                div(class='flex flex-col text-xs')
                    div(class='border-t-base-content/5 flex items-center justify-between gap-2 border-t border-dashed py-2') Total uploads
                        span(id='total_uploads') 0
                    div(class='border-t-base-content/5 flex items-center justify-between gap-2 border-t border-dashed py-2') Total images
                        span(id='total_images') 0
                    div(class='border-t-base-content/5 flex items-center justify-between gap-2 border-t border-dashed py-2') Total videos
                        span(id='total_videos') 0
                    div(class='border-t-base-content/5 flex items-center justify-between gap-2 border-t border-dashed py-2') Total links 
                        span(id='total_links') 0
                    div(class='border-t-base-content/5 flex items-center justify-between gap-2 border-t border-dashed py-2') Total files
                        span(id='total_files') 0


        div(class='stats bg-base-200 w-full md:w-1/4 overflow-hidden')
            div(class='stat')
                div(class='stat-figure')
                    i.fas.fa-database.fa-3x
                div(class='stat-title') Quota used
                div(class='stat-value' id='quota_used') 0GB / 100GB
                progress(class='progress w-full', value='10', max='100')


    div.mt-6.rounded-lg
        h2(class='text-2xl font-bold mb-4') Recent uploads

        div(class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 w-full' id='recent_uploads_grid')
            each val in [1,2,3,4,5]
                div(class='flex w-full flex-col gap-4')
                    div(class='skeleton h-60 w-full')
                    div(class='skeleton h-4 w-full')
                    div(class='skeleton h-4 w-full')
                    div(class='skeleton h-4 w-full')
                //- div(class='flex w-full flex-col gap-4')
