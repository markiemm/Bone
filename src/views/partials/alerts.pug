if (success!='')
    div(class='toast toast-top toast-center toast-msg' role='alert')
        div(class='alert alert-success items-center p-4 flex')
            .flex-shrink-0
                i.fas.fa-check-circle.text-2xl
            .flex-1
                .text-lg.font-bold
                    | Success!
                .text-sm.my-3
                    | #{success}
                .w-full.rounded-full.mb-4(class='h-2.5')
                    .bg-green-300.rounded-full.progress-bar(class='h-2.5' style='width: 100%')
    script.
        (function() {
            const toasts = document.querySelectorAll('.toast-msg');
            const toast = toasts[toasts.length - 1];
            const progressBar = toast.querySelector('.progress-bar');

            progressBar.style.width = '100%';
            for (let i = 100; i >= 0; i--) {
                setTimeout(() => {
                    progressBar.style.width = i + '%';
                }, 50 * (100 - i));

                if (i === 0) {
                    setTimeout(() => {
                        toast.style.display = 'none';
                    }, 50 * (100 - i));
                }
            }
        })();


